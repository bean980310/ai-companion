AI_COMPANION_CONFIG_ROOT = "${HOME}/.ai-companion"
AI_COMPANION_MCP_CONFIG = "${AI_COMPANION_CONFIG_ROOT}/mcp_servers.json"
AI_COMPANION_API_CONFIG = "${AI_COMPANION_CONFIG_ROOT}/config/environment.env"

OPENAI_API_KEY=sk-your-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
GEMINI_API_KEY=your-api-key-here
PERPLEXITY_API_KEY=pplx-your-api-key-here
XAI_API_KEY=xai-your-api-key-here
MISTRAL_API_KEY=your-api-key-here
STABILITY_API_KEY=sk-your-api-key-here

GROQ_API_KEY=gsk_your-api-key-here
TOGETHER_API_KEY=your-api-key-here
NOVITA_API_KEY=sk_your-api-key-here
COHERE_API_KEY=your-api-key-here
FIREWORKS_API_KEY=fw_your-api-key-here
NEBIUS_API_KEY=your-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

HF_TOKEN=hf_your-api-key-here
MODELSCOPE_API_TOKEN=ms-your-api-key-here

CIVITAI_API_TOKEN=your-api-key-here
REPLICATE_API_TOKEN=your-api-key-here

DEEPL_AUTH_TOKEN=your-api-key-here
EXA_API_KEY=your-api-key-here

# --- 장기기억 (mem0) ---
# LLM(메모리 추출)과 embedder(임베딩)의 프로바이더를 분리해 지정할 수 있습니다.
# MEMORY_LLM_PROVIDER / MEMORY_EMBEDDER_PROVIDER 를 지정하지 않으면
# MEMORY_PROVIDER 값이 양쪽에 함께 적용됩니다 (기본 "ollama").
# 지원 프로바이더:
#   LLM      : ollama, openai, vllm, lmstudio, deepseek, anthropic, gemini, groq, together, litellm, xai 등
#   embedder : ollama, openai, lmstudio, huggingface, gemini, together, fastembed 등
# ("custom" 은 "openai" 의 별칭입니다)
MEMORY_ENABLED=true
MEMORY_PROVIDER=ollama
MEMORY_VECTOR_STORE=chroma
MEMORY_COLLECTION=mem0
# MEMORY_STORE_PATH=${HOME}/.ai-companion/mem0
MEMORY_MAX_TOKENS=2000

# --- 메모리 추출 LLM 설정 ---
# Ollama 를 사용한다면 아래 모델이 pull 되어 있어야 합니다:
#   ollama pull gemma4:12b
# (mem0 메모리 추출용으로는 JSON 형식 {"memory":[...]} 을 잘 따르는 모델을 권장합니다.)
# MEMORY_LLM_PROVIDER=ollama
# MEMORY_LLM_BASE_URL=http://localhost:11434
# MEMORY_LLM_API_KEY=not-needed
# MEMORY_LLM_MODEL=gemma4:12b

# --- 임베딩 설정 ---
# Ollama 를 사용한다면 아래 모델이 pull 되어 있어야 합니다:
#   ollama pull nomic-embed-text
# MEMORY_EMBEDDER_PROVIDER=ollama
# MEMORY_EMBEDDER_BASE_URL=http://localhost:11434
# MEMORY_EMBEDDER_API_KEY=not-needed
# MEMORY_EMBEDDER_MODEL=nomic-embed-text
# 프로바이더 기본 차원과 다른 모델을 쓸 때만 지정하세요 (예: nomic-embed-text = 768)
# MEMORY_EMBEDDER_DIMS=768

# --- 예시: 임베딩은 로컬 Ollama, 메모리 추출 LLM은 vLLM 서버 ---
# MEMORY_EMBEDDER_PROVIDER=ollama
# MEMORY_LLM_PROVIDER=vllm
# MEMORY_LLM_BASE_URL=http://localhost:8000/v1
# MEMORY_LLM_MODEL=Qwen/Qwen3-32B

# --- 예시: 전부 LM Studio ---
# MEMORY_PROVIDER=lmstudio

# --- 하위 호환 (side별 값 미지정 시 공통 fallback) ---
# MEMORY_BASE_URL=http://localhost:8000/v1
# MEMORY_API_KEY=not-needed